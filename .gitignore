# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

.idea/
.DS_Store

password.txt

# Secrets (leak sweep 2026-10-30): env files, keys, keystores, secret dirs and DB dumps never go in git.
# Templates stay committable: .env.example, .env.*.example, .env.sample, .env.template.
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.*.sample
!.env.template
*.pem
*.key
*.p8
*.p12
*.pfx
*.jks
*.keystore
keystore.properties
keystore/*
!keystore/.gitkeep
secrets/
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.dump
*.sql.gz
